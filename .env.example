# Server-side proxy target (not exposed to the browser)
API_PROXY_TARGET=https://chathubapplication-4mr7.onrender.com

# Use same-origin paths in dev/production so any localhost port avoids CORS.
# Next.js rewrites forward these to API_PROXY_TARGET.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_SIGNALR_HUB_URL=/hubs/chat

# Local backend example:
# API_PROXY_TARGET=http://localhost:5000
# NEXT_PUBLIC_API_BASE_URL=/api
# NEXT_PUBLIC_SIGNALR_HUB_URL=/hubs/chat
